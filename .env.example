# --- Google Sheet (live data for the current season) ---------------------
# The spreadsheet the league runs on. Found in the sheet URL:
# https://docs.google.com/spreadsheets/d/<LEAGUE_SHEET_ID>/edit
LEAGUE_SHEET_ID=

# Service account credentials. EITHER paste the full JSON key file here...
GOOGLE_SERVICE_ACCOUNT_KEY=
# ...OR set the two fields separately (newlines in the key escaped as \n):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Tab names inside the sheet (defaults shown)
SCORES_TAB=Scores
# Week grid. Left unset, "Team by Team Schedule" is tried first, then "Schedule".
# SCHEDULE_TAB=Team by Team Schedule
ROSTERS_TAB=Rosters
ADJUSTMENTS_TAB=Adjustments
TRADES_TAB=Trades
DRAFT_TAB=Final Draft Board
TEAMS_TAB=Teams
PREDICTIONS_TAB=Predictions
LINEUPS_TAB=Lineups

# --- Commissioner --------------------------------------------------------
# Passcode for /commish (score entry). Rotating it signs everyone out.
COMMISH_PASSCODE=

# --- League ---------------------------------------------------------------
# Shared passcode for the whole league (post it in the group chat). Lets
# managers submit preseason predictions under their own name.
LEAGUE_PASSCODE=

# Public origin used in links pasted into the chat (recap text). Defaults to
# the production domain; set on preview deploys if you want them self-linking.
# NEXT_PUBLIC_SITE_URL=https://www.premierleagueff.com

# --- Season --------------------------------------------------------------
# The season being played. Bump this every year.
CURRENT_SEASON=2026
# When preseason predictions lock — Week 1 kickoff. ISO 8601 with offset.
PREDICTIONS_LOCK_AT=2026-09-10T20:15:00-04:00
